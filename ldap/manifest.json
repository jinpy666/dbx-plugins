{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/dev/plugin-framework-current/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.dbx.ldap",
  "name": "DBX LDAP",
  "version": "0.1.30",
  "publisher": "dbx",
  "description": "LDAP console plugin for DBX: DN tree, RFC 4515 search, entry editing, schema and search presets.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.77",
    "host_api": ">=1.0.0"
  },
  "permissions": [
    "host.events",
    "host.workbench"
  ],
  "entrypoints": {
    "backend": {
      "transport": "stdio-jsonl",
      "executable": "bin/dbx-plugin-ldap"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.ldap.connection",
      "label": "LDAP server",
      "icon": "assets/plugin.svg",
      "database_type": "ldap",
      "description": "LDAP directory connection with simple, anonymous, unauthenticated and advanced authentication.",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ],
      "workbench": "io.dbx.ldap.workbench",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "default": "LDAP server",
          "binding": "name",
          "required": true
        },
        {
          "key": "host",
          "label": "Server host",
          "type": "text",
          "description": "LDAP server hostname only, no scheme or port (example: dc01.corp.example.com). Connections saved with an older version keep their full ldap/ldaps URL and continue to work.",
          "placeholder": "dc01.corp.example.com",
          "default": "127.0.0.1",
          "binding": "host",
          "required": true
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "description": "389 for ldap/StartTLS, 636 for LDAPS; leave empty for the scheme default.",
          "default": 389,
          "binding": "port",
          "required": true
        },
        {
          "key": "tls_mode",
          "label": "Encryption",
          "type": "select",
          "options": [
            {
              "label": "None (ldap)",
              "value": "none"
            },
            {
              "label": "StartTLS",
              "value": "starttls"
            },
            {
              "label": "LDAPS (TLS)",
              "value": "ldaps"
            }
          ],
          "default": "none",
          "binding": "config"
        },
        {
          "key": "tls_verify",
          "label": "Verify TLS certificate",
          "type": "boolean",
          "default": true,
          "binding": "config",
          "visible_when": {
            "field": "tls_mode",
            "one_of": [
              "starttls",
              "ldaps"
            ]
          }
        },
        {
          "key": "tls_ca_path",
          "label": "TLS CA certificate path",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "tls_mode",
            "one_of": [
              "starttls",
              "ldaps"
            ]
          }
        },
        {
          "key": "tls_server_name",
          "label": "TLS server name",
          "type": "text",
          "description": "Defaults to the host in the URL when empty.",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "tls_mode",
            "one_of": [
              "starttls",
              "ldaps"
            ]
          }
        },
        {
          "key": "base_dn",
          "label": "Base DN",
          "type": "text",
          "default": "",
          "binding": "config"
        },
        {
          "key": "auth_type",
          "label": "Authentication",
          "type": "select",
          "options": [
            {
              "label": "Anonymous",
              "value": "anonymous"
            },
            {
              "label": "Unauthenticated bind",
              "value": "unauthenticated"
            },
            {
              "label": "Simple",
              "value": "simple"
            },
            {
              "label": "Kerberos (GSSAPI)",
              "value": "kerberos"
            },
            {
              "label": "NTLM",
              "value": "ntlm"
            },
            {
              "label": "NTLM hash",
              "value": "ntlm_hash"
            },
            {
              "label": "DIGEST-MD5",
              "value": "digest_md5"
            },
            {
              "label": "External (SASL EXTERNAL)",
              "value": "external"
            }
          ],
          "default": "simple",
          "binding": "config"
        },
        {
          "key": "bind_dn",
          "label": "Bind DN",
          "type": "text",
          "description": "DN used for the bind. Required for unauthenticated bind (DN with empty password).",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "simple",
              "unauthenticated"
            ]
          },
          "required_when": {
            "field": "auth_type",
            "one_of": [
              "unauthenticated"
            ]
          }
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "simple",
              "ntlm",
              "ntlm_hash",
              "digest_md5",
              "kerberos"
            ]
          },
          "required_when": {
            "field": "auth_type",
            "one_of": [
              "ntlm",
              "ntlm_hash",
              "digest_md5"
            ]
          }
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "ntlm",
              "ntlm_hash",
              "digest_md5"
            ]
          }
        },
        {
          "key": "bind_password",
          "label": "Bind password",
          "type": "password",
          "default": "",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "simple",
              "ntlm",
              "digest_md5"
            ]
          },
          "required_when": {
            "field": "auth_type",
            "one_of": [
              "simple",
              "ntlm",
              "digest_md5"
            ]
          }
        },
        {
          "key": "ntlm_hash",
          "label": "NTLM hash",
          "type": "password",
          "default": "",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "ntlm_hash"
            ]
          },
          "required_when": {
            "field": "auth_type",
            "one_of": [
              "ntlm_hash"
            ]
          }
        },
        {
          "key": "krb_credential_type",
          "label": "Kerberos credential type",
          "type": "select",
          "options": [
            {
              "label": "Password",
              "value": "password"
            },
            {
              "label": "Keytab",
              "value": "keytab"
            },
            {
              "label": "Credential cache (ccache)",
              "value": "ccache"
            }
          ],
          "default": "password",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "krb_realm",
          "label": "Kerberos realm",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "krb_kdc_host",
          "label": "KDC host",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "krb_kdc_port",
          "label": "KDC port",
          "type": "number",
          "default": 88,
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "krb_keytab_path",
          "label": "Keytab file path",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "krb_credential_type",
            "one_of": [
              "keytab"
            ]
          }
        },
        {
          "key": "krb_ccache_path",
          "label": "Credential cache path",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "krb_credential_type",
            "one_of": [
              "ccache"
            ]
          }
        },
        {
          "key": "krb5_conf_path",
          "label": "krb5.conf path",
          "type": "text",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "sasl_host",
          "label": "SASL host override",
          "type": "text",
          "description": "Optional DIGEST-MD5 SASL host; defaults to the host in the LDAP URL.",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "digest_md5"
            ]
          }
        },
        {
          "key": "krb_username",
          "label": "Kerberos username override",
          "type": "text",
          "description": "Optional principal username (without realm); defaults to the username field.",
          "default": "",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "sasl_qop",
          "label": "Quality of protection",
          "type": "select",
          "description": "GSSAPI quality of protection (kerberos).",
          "options": [
            {
              "label": "Authentication only",
              "value": "auth"
            },
            {
              "label": "Authentication with integrity",
              "value": "auth-int"
            },
            {
              "label": "Authentication with confidentiality",
              "value": "auth-conf"
            }
          ],
          "default": "auth",
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "sasl_mutual_auth",
          "label": "Mutual authentication",
          "type": "boolean",
          "description": "Request mutual authentication in the GSSAPI context.",
          "default": false,
          "binding": "config",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "krb_password",
          "label": "Kerberos password",
          "type": "password",
          "description": "Secret used only when the Kerberos credential type is password (ignored for keytab/ccache).",
          "default": "",
          "binding": "secret",
          "visible_when": {
            "field": "auth_type",
            "one_of": [
              "kerberos"
            ]
          }
        },
        {
          "key": "timeout_secs",
          "label": "Timeout (seconds)",
          "type": "number",
          "default": 30,
          "binding": "config"
        },
        {
          "key": "read_only",
          "label": "Read-only",
          "type": "boolean",
          "default": false,
          "binding": "config"
        },
        {
          "key": "allowed_base_dns",
          "label": "Allowed base DNs (read)",
          "type": "textarea",
          "description": "One DN per line; empty means unrestricted.",
          "default": "",
          "binding": "config"
        },
        {
          "key": "allowed_write_base_dns",
          "label": "Allowed base DNs (write)",
          "type": "textarea",
          "description": "Falls back to the read allowlist when empty.",
          "default": "",
          "binding": "config"
        },
        {
          "key": "blocked_attributes",
          "label": "Blocked attributes",
          "type": "textarea",
          "description": "One attribute name per line; filtered from results and rejected on writes.",
          "default": "userPassword\nunicodePwd\npassword\npwd\nsecret\ntoken\napiKey\nprivateKey\nobjectSid\nobjectGUID\nmemberOf",
          "binding": "config"
        }
      ]
    },
    {
      "type": "workbench",
      "id": "io.dbx.ldap.workbench",
      "label": "LDAP Workbench",
      "description": "Browse and edit LDAP directory entries.",
      "icon": "assets/plugin.svg"
    }
  ],
